# Copy to .env (gitignored). JWT verify for POST /v1/horoscope/* uses this
# URL to fetch JWKS. Must match the Flutter/Supabase project.
# Never put service_role or DEEPSEEK keys here.
#
# Local integration with Flutter:
#   SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
#   Do NOT export TUVI_MCP_AUTH_DISABLED when running uvicorn for app testing.
#   That flag is for pytest only (see tests/test_api_horoscope.py monkeypatch).
#
# Production:
#   TUVI_MCP_ENV=production
#   SUPABASE_URL must be set (auth disable flag is ignored in production).

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
